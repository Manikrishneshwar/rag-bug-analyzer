# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# --- LLM for the diagnosis/synthesis step ---
# groq = free tier (default). openai = billed, no free tier.
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys (no card required)
GROQ_API_KEY=gsk_your-key-here
# If this 404s, Groq retired it — list current models with:
#   python -c "from groq import Groq; import os; from dotenv import load_dotenv; load_dotenv(); [print(m.id) for m in Groq(api_key=os.environ['GROQ_API_KEY']).models.list().data]"
GROQ_MODEL=openai/gpt-oss-20b

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model. Options:
#   openai:text-embedding-3-small   -> fast, costs ~$0.02 per 50K docs
#   local:all-MiniLM-L6-v2          -> free, runs locally via sentence-transformers, slower
EMBEDDING_MODE=local:all-MiniLM-L6-v2

# --- Vector DB ---
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=stackoverflow_qa

# --- Data ingestion ---
# How many SO question+answer pairs to index. Start small (2000) to
# iterate fast, raise to 50000-100000 for the "real" run.
SO_DATA_LIMIT=2000
HF_DATASET_NAME=mikex86/stackoverflow-posts
# Raise if setup.py logs fewer matched pairs than SO_DATA_LIMIT.
# Default: max(20000, SO_DATA_LIMIT * 8).
# HF_SCAN_LIMIT=20000

# --- App ---
APP_TOP_K=5
